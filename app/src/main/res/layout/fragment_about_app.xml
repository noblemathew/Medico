<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/med"
        android:text="About Medico."
        android:fontFamily="@font/poppinsm"
        android:textAlignment="center"
        android:layout_marginTop="24sp"
        android:textSize="24sp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/med"
        android:fontFamily="@font/poppinsr"
        android:layout_marginTop="30dp"
        android:textSize="16sp"
        android:layout_marginHorizontal="20dp"
        android:text="Medico is an android application which enables you to shop across various types of medicines and other medical utensils. There is much development taking place in this application. More updates will be available to you soon"/>
</RelativeLayout>